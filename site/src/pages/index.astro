---
import Layout from '../layouts/Layout.astro';
import MacWindow from '../components/MacWindow.astro';
import Library from '../components/Library.astro';
import Demos from '../components/Demos.astro';
import Icon from '../components/Icon.astro';
import FamilyTabs from '../components/FamilyTabs.astro';
import release from '../release.json';

const title = 'Slinky keeps secrets out of files.';
const description = 'A free, native Mac app for API keys, .env variables and recovery codes. Encrypted on your Mac and opened with Touch ID.';
const versionLine = `v${release.version} · ${release.minOS} · Apple silicon and Intel`;

const compare = {
  cols: ['Slinky', 'Apple Passwords', '1Password', '.env files', 'Doppler or Infisical', 'Keychain Access'],
  rows: [
    ['Made for API keys and tokens', ['yes', 'no', 'yes', 'part:Plain text', 'yes', 'part:Generic items']],
    ['A project’s .env, per environment', ['yes', 'no', 'part:With its CLI', 'yes', 'yes', 'no']],
    ['Recovery codes that cross themselves off', ['yes', 'no', 'no', 'no', 'no', 'no']],
    ['Stays on your Mac', ['yes', 'part:iCloud', 'no:Their cloud', 'part:Unencrypted', 'no:Their servers', 'yes']],
    ['Opens with Touch ID', ['yes', 'yes', 'yes', 'no', 'no', 'part:Password']],
    ['Price', ['Free, open source', 'Free', 'Subscription', 'Free', 'Free tier, then paid', 'Free']],
  ] as [string, string[]][],
};
const mark = (v: string) => {
  const [kind, text] = v.includes(':') ? v.split(':') : [v, ''];
  if (kind === 'yes') return { cls: 'yes', text: text || 'Yes' };
  if (kind === 'no') return { cls: 'no', text: text || 'No' };
  if (kind === 'part') return { cls: 'part', text };
  return { cls: '', text: v };
};

const faq = [
  ['Is Slinky free?', 'Yes. Slinky is free and open source under the MIT License, made by Testament Made, LLC, the same people behind Dinky and Binky.'],
  ['Where are my things stored?', 'In one encrypted file on your Mac. The key that opens it is protected by your Mac’s Secure Enclave and opened with Touch ID. A printed Recovery Key is the backup.'],
  ['Is there an account or sync?', 'No account, no server and no sync. The only time Slinky goes online is a daily check with GitHub for a newer version, which you can turn off. Time Machine backs up the encrypted file like any other.'],
  ['What if I lose my Mac?', 'Restore your backup on a new Mac and open Slinky with your Recovery Key. Slinky then sets up Touch ID on that Mac.'],
  ['Why does macOS say it can’t check Slinky?', 'Slinky is signed but not notarized yet. The first time, open System Settings › Privacy & Security and click Open Anyway. You only do this once; updates install without asking again.'],
  ['Should I keep passwords in Slinky?', 'No. Website passwords belong in Apple Passwords. Slinky is for the other things: API keys, tokens, .env variables, backup codes and recovery keys.'],
  ['Does Slinky change my project files?', 'No. It reads your .env files and .gitignore to set things up. It only writes a file when you choose Save .env.example, which has names and no values.'],
  ['What about clipboard history apps?', 'Everything Slinky copies is marked private, so Raycast, Paste, Maccy and others skip it, and the clipboard clears itself after 60 seconds.'],
  ['Can I bring my keys from another app?', 'Yes. Import a 1Password export or a CSV from Apple Passwords, Bitwarden or a spreadsheet. Slinky picks out keys, tokens and codes, and leaves passwords behind.'],
  ['Will it work with AI coding tools?', 'That’s next. Slinky 1.1 adds a slinky command and an MCP connection, so tools like Claude Code can run your app with the real keys while only ever seeing dots.'],
];
---
<Layout title={`Slinky · ${title}`} description={description}>
  <FamilyTabs current="slinky" />

  <main id="top">
    <header class="hero wrap">
      <picture class="hero__icon">
        <source srcset="/icons/slinky-320-dark.webp" media="(prefers-color-scheme: dark)" />
        <img src="/icons/slinky-320.webp" alt="Slinky's app icon: a glass asterisk with a keyhole" width="128" height="128" />
      </picture>
      <h1>{title}</h1>
      <p class="hero__lede">A free Mac app for API keys, .env variables and recovery codes. Encrypted on your Mac, opened with Touch ID.</p>
      <div class="hero__actions">
        <a class="btn btn--primary" href={release.dmg} data-download><Icon name="download" /> Download for Mac</a>
        <a class="btn btn--quiet" href="https://github.com/heyderekj/slinky"><Icon name="github" /> View on GitHub</a>
      </div>
      <p class="hero__meta">{versionLine} · <button type="button" data-open-install>How to install</button></p>
      <div class="stage">
        <MacWindow title="All Items" subtitle="6 items" selected="all" id="hero-window">
          <Library />
          <div slot="over" class="toast float-glass" data-toast><Icon name="checkc" /><span data-toast-text>Copied.</span></div>
        </MacWindow>
      </div>
    </header>

    <section class="section wrap center" id="features">
      <p class="eyebrow">One home</p>
      <h2>Everything you’re told to “store somewhere safe”</h2>
      <p class="section__lede">API keys, each project’s .env, backup codes and recovery keys. Paste it, and Slinky knows where it goes.</p>
      <Demos which="kinds" />
      <p class="kinds__head" id="kinds-head" aria-live="polite">A safe home for your API keys.</p>
    </section>

    <div class="wrap">
      <section class="feature reveal">
        <div class="feature__text">
          <p class="eyebrow">Add Item</p>
          <h2>Paste anything secret</h2>
          <p class="section__lede">Press ⌘N and paste. The value turns into dots right away, Slinky says what it looks like, and suggests where it belongs.</p>
          <ul>
            <li>Recognizes Stripe, OpenAI, Anthropic, GitHub, Supabase, Resend, AWS and more.</li>
            <li>Tells you if you’ve already saved it, and where.</li>
            <li>Says no to crypto wallet phrases, for your safety.</li>
          </ul>
        </div>
        <div class="feature__demo"><Demos which="additem" /></div>
      </section>

      <section class="feature feature--flip reveal">
        <div class="feature__text">
          <p class="eyebrow">Projects</p>
          <h2>Your app’s secrets, out of its files</h2>
          <p class="section__lede">Drop a project folder. Slinky reads its .env files, sorts them into Local, Preview and Production, and shows what .env.example says is missing.</p>
          <ul>
            <li>Warns when git could commit a .env file.</li>
            <li>Copy an environment as .env lines for your host’s dashboard.</li>
            <li>Save a .env.example with names only, safe to commit.</li>
          </ul>
        </div>
        <div class="feature__demo"><Demos which="env" /></div>
      </section>

      <section class="feature reveal">
        <div class="feature__text">
          <p class="eyebrow">Recovery</p>
          <h2>Backup codes, ready when you’re locked out</h2>
          <p class="section__lede">Copy a code and Slinky crosses it off, so you never try a used one. It tells you when you’re running low, and keeps recovery keys safe for the day you need them.</p>
          <ul>
            <li>Try it: click a code in the window at the top of the page.</li>
            <li>Recovery keys without a printed copy show up in Needs Attention.</li>
          </ul>
        </div>
        <div class="feature__demo">
          <div class="additem" data-glass="panel" style="max-width:380px">
            <div class="card" data-codeset>
              <div class="card__head">
                <span class="mono-tile" style="--s:30px;background:linear-gradient(#ffd675,#f08f24)">V</span>
                <div><div class="card__kind">RECOVERY CODES</div><div class="card__name">Vercel</div><div class="card__sub">harbor@example.com</div></div>
                <div class="left is-low"><b data-left>4</b><small>left</small></div>
              </div>
              <div class="codes">
                {['b8x2k-4mq9t', 'n3v7p-1zr5w', 'c6h4d-8yt2e', 'p9k1s-5qx7m'].map((c) => <button class="code" data-code>{c}</button>)}
                {['t2w6r-9bn3j', 'f5m8c-2kd4x'].map((c) => <span class="code is-used">{c}<Icon name="check" class="tick" /></span>)}
              </div>
            </div>
            <p class="detect" style="margin-top:12px"><Icon name="attention" style="width:14px;height:14px;color:var(--orange)" /> Only 4 codes left. Consider making new ones.</p>
          </div>
        </div>
      </section>

      <section class="feature feature--flip reveal">
        <div class="feature__text">
          <p class="eyebrow">Quick Access</p>
          <h2>⌥⌘K, from anywhere</h2>
          <p class="section__lede">Find a key by name and press Return. Copies are private, so clipboard history apps skip them, and they clear themselves after a minute.</p>
          <ul>
            <li>Try it: type “stripe” or “codes”, then press Return.</li>
            <li>⌘Return copies KEY=value, ready for a .env.</li>
          </ul>
        </div>
        <div class="feature__demo"><Demos which="quick" /></div>
      </section>

      <section class="feature reveal">
        <div class="feature__text">
          <p class="eyebrow">Locking</p>
          <h2>Locks itself</h2>
          <p class="section__lede">Touch ID to open. Slinky locks when your screen locks, when your Mac sleeps, when you’re away, and after 12 hours. Or flip the switch.</p>
          <ul>
            <li>Nothing secret is on screen while it locks.</li>
            <li>A printed Recovery Key opens it on any Mac.</li>
          </ul>
        </div>
        <div class="feature__demo"><Demos which="lock" /></div>
      </section>
    </div>

    <section class="section wrap center">
      <p class="eyebrow">Also in Slinky</p>
      <h2>Small, native, and thought through</h2>
      <div class="grid3" style="text-align:left">
        <div class="tile" data-glass="panel"><Icon name="attention" /><h3>Needs Attention</h3><p>Codes running low, variables missing, keys about to expire, recovery keys never printed.</p></div>
        <div class="tile" data-glass="panel"><Icon name="import" /><h3>Import</h3><p>Bring keys from 1Password, Apple Passwords, Bitwarden or a CSV. Passwords stay behind.</p></div>
        <div class="tile" data-glass="panel"><Icon name="layers" /><h3>Shortcuts</h3><p>Add to Slinky, Copy from Slinky (Touch ID every time), Quick Access and Lock.</p></div>
        <div class="tile" data-glass="panel"><Icon name="gear" /><h3>Settings that matter</h3><p>When to lock, how long until the clipboard clears, sounds, open at login.</p></div>
        <div class="tile" data-glass="panel"><Icon name="update" /><h3>Updates in place</h3><p>One click, and only if the update is signed by Slinky’s developer.</p></div>
        <div class="tile" data-glass="panel"><Icon name="feather" /><h3>A {release.sizeMB} MB download</h3><p>Native Swift and Apple frameworks only. No web views, no dependencies.</p></div>
      </div>
    </section>

    <section class="section wrap center" id="compare">
      <p class="eyebrow">Compare</p>
      <h2>Where Slinky fits</h2>
      <p class="section__lede">Apple Passwords is great for logins. Slinky is for everything else you’re told to keep safe.</p>
      <div class="compare" data-glass="panel">
        <table>
          <thead><tr><th></th>{compare.cols.map((c, i) => <th class={i === 0 ? 'us' : ''} scope="col">{c}</th>)}</tr></thead>
          <tbody>
            {compare.rows.map(([label, cells]) => (
              <tr><th scope="row">{label}</th>{cells.map((v, i) => { const m = mark(v); return <td class={`${i === 0 ? 'us' : ''} ${m.cls}`}>{m.text}</td>; })}</tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="compare__note">As of October 2026. Corrections welcome at help@slinkyfiles.com.</p>
    </section>

    <section class="section wrap center">
      <p class="eyebrow">Coming in 1.1</p>
      <h2>AI agents use your keys without seeing them</h2>
      <div class="next" data-glass="panel" style="text-align:left">
        <div class="next__term" aria-label="An example terminal session">
          <div><span class="dim">$</span> slinky run -- npm run dev</div>
          <div class="dim">Using 9 variables from harbor-app (Local)</div>
          <div>Claude asked for STRIPE_SECRET_KEY. <span class="ok">Allowed once.</span></div>
          <div><span class="ok">✓</span> Running. Claude sees ••••••••. Your app sees the key.</div>
        </div>
        <div>
          <span class="badge">Coming in 1.1</span>
          <p class="section__lede" style="margin-top:12px">A slinky command and an MCP connection let tools like Claude Code run your app with the real keys while only ever seeing dots. Slinky asks before anything sensitive is used, and keeps a record of what each agent used.</p>
        </div>
      </div>
    </section>

    <section class="section wrap center" id="privacy">
      <p class="eyebrow">Privacy</p>
      <h2>Your things, in plain English</h2>
      <div class="plain" style="text-align:left">
        <div class="tile" data-glass="panel"><Icon name="shield" /><h3>Where they live</h3><ul><li>One encrypted file on your Mac.</li><li>Opened by your Mac’s Secure Enclave with Touch ID, or your printed Recovery Key.</li><li>Locked means the key isn’t in memory at all.</li></ul></div>
        <div class="tile" data-glass="panel"><Icon name="update" /><h3>What leaves your Mac</h3><ul><li>Nothing about you or your vault.</li><li>Once a day, a check with GitHub for a newer version. You can turn it off.</li><li>No account, no analytics in the app, no server.</li></ul></div>
      </div>
    </section>

    <section class="section wrap center" id="faq">
      <p class="eyebrow">Questions</p>
      <h2>Good to know</h2>
      <div class="faq" style="text-align:left">
        {faq.map(([q, a]) => <details data-glass="panel"><summary>{q}</summary><p>{a}</p></details>)}
      </div>
    </section>

    <section class="section wrap">
      <div class="stairs" data-stairs aria-hidden="true">
        {[0, 1, 2, 3, 4].map((i) => (
          <div class="stairs__step" data-glass="capsule" style={`left:${i * 110}px;top:${30 + i * 44}px;width:120px`}>{i === 4 && <span>.env</span>}</div>
        ))}
        <div class="stairs__pill" data-glass="capsule">sk_live_••••4f2a</div>
      </div>
      <p class="stairs__caption">Go, Slinky, go. Every step but the last one.</p>
    </section>
  </main>

  <nav class="bar float-glass" aria-label="Slinky">
    <a class="bar__home" href="#top"><img src="/icons/slinky-320.webp" alt="" width="26" height="26" /> Slinky</a>
    <a class="bar__link" href="#features">Features</a>
    <a class="bar__link" href="#compare">Compare</a>
    <a class="bar__link" href="#privacy">Privacy</a>
    <a class="bar__link" href="#faq">FAQ</a>
    <a class="btn btn--quiet btn--small" href="https://github.com/heyderekj/slinky" data-stars><Icon name="github" /><span data-star-count>GitHub</span></a>
    <a class="btn btn--primary btn--small" href={release.dmg} data-download>Download</a>
  </nav>

  <footer class="foot wrap">
    <span>Made by <a href="https://testamentmade.com">Testament Made, LLC</a> · <a href="mailto:help@slinkyfiles.com">help@slinkyfiles.com</a></span>
    <nav aria-label="Family">
      <a class="family" href="https://dinkyfiles.com"><img src="/family/dinky.webp" alt="" width="24" height="24" /> Dinky makes files smaller.</a>
      <a class="family" href="https://binkyfiles.com"><img src="/family/binky.webp" alt="" width="24" height="24" /> Binky sorts your files.</a>
    </nav>
    <nav aria-label="More">
      <a href="https://github.com/heyderekj/slinky">GitHub</a>
      <a href="https://github.com/heyderekj/slinky/releases">Releases</a>
      <a href="https://github.com/heyderekj/slinky/blob/main/LICENSE">MIT License</a>
    </nav>
  </footer>

  <div class="modal" data-install role="dialog" aria-modal="true" aria-labelledby="install-title">
    <div class="modal__box">
      <button class="modal__close" type="button" data-close-install aria-label="Close">×</button>
      <h3 id="install-title">How to install Slinky</h3>
      <div class="tabs" role="tablist">
        <button role="tab" aria-selected="true" data-tab="dmg" type="button">Download &amp; install</button>
        <button role="tab" aria-selected="false" data-tab="brew" type="button">Homebrew</button>
      </div>
      <div data-panel="dmg">
        <ol>
          <li>Open <b>Slinky-{release.version}.dmg</b> and drag Slinky into Applications.</li>
          <li>Open Slinky. macOS says it can’t check it, because Slinky isn’t notarized yet.</li>
          <li>Open <b>System Settings › Privacy &amp; Security</b>, scroll down and click <b>Open Anyway</b>. Once is enough; updates install without asking again.</li>
        </ol>
        <p style="font-size:14.5px;color:var(--muted)">Still blocked? This command clears the download flag:</p>
        <div class="cmd"><code>xattr -dr com.apple.quarantine /Applications/Slinky.app</code><button type="button" data-copy-cmd>Copy</button></div>
      </div>
      <div data-panel="brew" hidden>
        <div class="cmd"><code>brew tap heyderekj/slinky https://github.com/heyderekj/slinky</code><button type="button" data-copy-cmd>Copy</button></div>
        <div class="cmd"><code>brew install --cask slinky</code><button type="button" data-copy-cmd>Copy</button></div>
      </div>
    </div>
  </div>
</Layout>
