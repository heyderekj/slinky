---
import Layout from '../layouts/Layout.astro';
import MacWindow from '../components/MacWindow.astro';
import Library from '../components/Library.astro';
import Demos from '../components/Demos.astro';
import Icon from '../components/Icon.astro';
import FamilyTabs from '../components/FamilyTabs.astro';
import Desktop from '../components/Desktop.astro';
import release from '../release.json';

const title = 'Slinky keeps secrets out of files.';
const description = 'A free, native Mac app for API keys, .env variables and recovery codes. Encrypted on your Mac and opened with Touch ID.';
const versionLine = `v${release.version} · ${release.minOS} · Apple silicon`;

const compare = {
  cols: ['Slinky', 'Apple Passwords', '1Password', '.env files', 'Doppler or Infisical', 'Keychain Access'],
  rows: [
    ['Made for API keys and tokens', ['yes', 'no', 'yes', 'part:Plain text', 'yes', 'part:Generic items']],
    ['A project’s .env, per environment', ['yes', 'no', 'part:With its CLI', 'yes', 'yes', 'no']],
    ['Recovery codes that cross themselves off', ['yes', 'no', 'no', 'no', 'no', 'no']],
    ['Stays on your Mac', ['yes', 'part:iCloud', 'no:Their cloud', 'part:Unencrypted', 'no:Their servers', 'yes']],
    ['Opens with Touch ID', ['yes', 'yes', 'yes', 'no', 'no', 'part:Password']],
    ['Price', ['Free, open source', 'Free', 'Subscription', 'Free', 'Free tier, then paid', 'Free']],
  ] as [string, string[]][],
};
// Each cell is a mark (check, half circle, dash) plus an optional short note. One ink color; Slinky's column
// carries the brand. The words are there for screen readers.
const mark = (v: string) => {
  const [kind, note] = v.includes(':') ? v.split(':') : [v, ''];
  if (kind === 'yes') return { cls: 'yes', icon: 'checkc', label: 'Yes', note };
  if (kind === 'no') return { cls: 'no', icon: 'dash', label: 'No', note };
  if (kind === 'part') return { cls: 'part', icon: 'half', label: 'Partly', note };
  return { cls: 'text', icon: '', label: '', note: v };
};

const faq = [
  ['Is Slinky free?', 'Yes. Slinky is free and open source under the MIT License, made by Testament Made, LLC, the same people behind Dinky and Binky.'],
  ['Where are my things stored?', 'In one encrypted file on your Mac. The key that opens it is protected by your Mac’s Secure Enclave and opened with Touch ID. A printed Recovery Key is the backup.'],
  ['Is there an account or sync?', 'No account, no server and no sync. The only time Slinky goes online is a daily check with GitHub for a newer version, which you can turn off. Time Machine backs up the encrypted file like any other.'],
  ['What if I lose my Mac?', 'Restore your backup on a new Mac and open Slinky with your Recovery Key. Slinky then sets up Touch ID on that Mac.'],
  ['Why does macOS say it can’t check Slinky?', 'Slinky is signed but not notarized yet. The first time, open System Settings › Privacy & Security and click Open Anyway. You only do this once; updates install without asking again.'],
  ['Should I keep passwords in Slinky?', 'No. Website passwords belong in Apple Passwords. Slinky is for the other things: API keys, tokens, .env variables, backup codes and recovery keys.'],
  ['Does Slinky change my project files?', 'No. It reads your .env files and .gitignore to set things up. It only writes a file when you choose Save .env.example, which has names and no values.'],
  ['What about clipboard history apps?', 'Everything Slinky copies is marked private, so Raycast, Paste, Maccy and others skip it, and the clipboard clears itself after 60 seconds.'],
  ['Can I bring my keys from another app?', 'Yes. Import a 1Password export or a CSV from Apple Passwords, Bitwarden or a spreadsheet. Slinky picks out keys, tokens and codes, and leaves passwords behind.'],
  ['Will it work with AI coding tools?', 'That’s next. Slinky 1.1 adds a slinky command and an MCP connection, so tools like Claude Code can run your app with the real keys while only ever seeing dots.'],
];
---
<Layout title={`Slinky · ${title}`} description={description}>
  <nav class="nav float-glass is-tucked" aria-label="Slinky">
    <a class="nav__home" href="#top"><img src="/icons/slinky-320.webp" alt="" width="26" height="26" /> Slinky</a>
    <a class="nav__link" href="#features">Features</a>
    <a class="nav__link" href="#compare">Compare</a>
    <a class="nav__link" href="#privacy">Privacy</a>
    <a class="nav__link" href="#faq">FAQ</a>
    <a class="btn btn--quiet btn--small" href="https://github.com/heyderekj/slinky" data-stars aria-label="Slinky on GitHub"><Icon name="github" /><span class="star-count" data-star-count></span></a>
    <a class="btn btn--primary btn--small" href={release.dmg} data-download>Download</a>
  </nav>

  <main id="top">
    <header class="hero wrap">
      <picture class="hero__icon">
        <source srcset="/icons/slinky-320-dark.webp" media="(prefers-color-scheme: dark)" />
        <img src="/icons/slinky-320.webp" alt="Slinky's app icon: a glass asterisk with a keyhole" width="128" height="128" />
      </picture>
      <h1>Slinky</h1>
      <p class="tagline">{title}</p>
      <p class="description">A free Mac app for API keys, .env variables and recovery codes. Encrypted on your Mac, opened with Touch ID. Free and open source.</p>
      <div class="hero__actions">
        <a class="btn btn--primary" href={release.dmg} data-download><Icon name="download" /> Download for Mac</a>
        <a class="btn btn--quiet" href="https://github.com/heyderekj/slinky" data-stars><Icon name="github" /> GitHub <span class="star-count" data-star-count></span></a>
      </div>
      <p class="hero__meta">{versionLine} · <button type="button" data-open-install>How to install</button></p>

      <Desktop class="desktop--hero" menubar>
        <MacWindow title="All Items" subtitle="6 items" selected="all" id="hero-window">
          <Library />
          <div slot="over" class="toast float-glass" data-toast><Icon name="checkc" /><span data-toast-text>Copied.</span></div>
        </MacWindow>
      </Desktop>
      <div class="ss-trio">
        <div class="ss-card card-plain"><Icon name="key" class="feature-icon" /><h3>Keys &amp; Tokens</h3><p>API keys and access tokens your software and AI tools use, with expiry dates and live-key warnings.</p></div>
        <div class="ss-card card-plain"><Icon name="folder" class="feature-icon" /><h3>Projects</h3><p>Each app’s .env variables for Local, Preview and Production, out of the project folder.</p></div>
        <div class="ss-card card-plain"><Icon name="life" class="feature-icon" /><h3>Recovery</h3><p>Backup codes that cross themselves off, and recovery keys for the day you need them.</p></div>
      </div>
    </header>

    <section class="screenshots wrap" id="features" aria-label="What Slinky does">
      <div class="ss-row is-rev reveal">
        <div class="ss-card card-plain">
          <div class="ss-card-features">
            <div class="ss-card-feature"><Icon name="plus" class="feature-icon" /><h3>Paste anything secret</h3><p>Press ⌘N and paste. The value turns into dots right away, and Slinky suggests where it belongs.</p></div>
            <div class="ss-card-feature"><Icon name="sparkle" class="feature-icon" /><h3>Knows the service</h3><p>Stripe, OpenAI, Anthropic, GitHub, Supabase, Resend, AWS and more, with the usual variable name filled in.</p></div>
            <div class="ss-card-feature"><Icon name="attention" class="feature-icon" /><h3>No accidental doubles</h3><p>Paste something you’ve already saved and Slinky tells you where it is. Wallet phrases are refused.</p></div>
          </div>
        </div>
        <Desktop><Demos which="additem" /></Desktop>
      </div>

      <div class="ss-row reveal">
        <Desktop><Demos which="env" /></Desktop>
        <div class="ss-card card-plain">
          <div class="ss-card-features">
            <div class="ss-card-feature"><Icon name="folder" class="feature-icon" /><h3>Drop a project folder</h3><p>Slinky reads its .env files and sorts them into Local, Preview and Production. It never changes them.</p></div>
            <div class="ss-card-feature"><Icon name="attention" class="feature-icon" /><h3>Checks .gitignore</h3><p>Files git could commit get a warning, before they end up in your repo.</p></div>
            <div class="ss-card-feature"><Icon name="check" class="feature-icon" /><h3>Shows what’s missing</h3><p>.env.example tells Slinky what the project needs. Copy an environment as .env lines when your host asks.</p></div>
          </div>
        </div>
      </div>

      <div class="ss-row is-rev reveal">
        <div class="ss-card card-plain">
          <div class="ss-card-features">
            <div class="ss-card-feature"><Icon name="hash" class="feature-icon" /><h3>Codes that cross themselves off</h3><p>Copy a backup code and it’s marked used, so you never try one twice.</p></div>
            <div class="ss-card-feature"><Icon name="bell" class="feature-icon" /><h3>A heads-up when you’re low</h3><p>Needs Attention lists codes running out, keys about to expire, and recovery keys never printed.</p></div>
            <div class="ss-card-feature"><Icon name="life" class="feature-icon" /><h3>Recovery keys, kept safe</h3><p>For the day you’re locked out of an account. Print them from Slinky in one click.</p></div>
          </div>
        </div>
        <Desktop>
          <div class="additem" data-glass="panel" style="max-width:380px">
            <div class="card" data-codeset>
              <div class="card__head">
                <span class="mono-tile" style="--s:30px;background:linear-gradient(#ffd675,#f08f24)">V</span>
                <div><div class="card__kind">RECOVERY CODES</div><div class="card__name">Vercel</div><div class="card__sub">harbor@example.com</div></div>
                <div class="left is-low"><b data-left>4</b><small>left</small></div>
              </div>
              <div class="codes">
                {['b8x2k-4mq9t', 'n3v7p-1zr5w', 'c6h4d-8yt2e', 'p9k1s-5qx7m'].map((c) => <button class="code" data-code>{c}</button>)}
                {['t2w6r-9bn3j', 'f5m8c-2kd4x'].map((c) => <span class="code is-used">{c}<Icon name="check" class="tick" /></span>)}
              </div>
            </div>
            <p class="detect" style="margin-top:12px"><Icon name="attention" style="width:14px;height:14px;color:var(--orange)" /> Only 4 codes left. Click one to copy it.</p>
          </div>
        </Desktop>
      </div>

      <div class="ss-row reveal">
        <Desktop><Demos which="quick" /></Desktop>
        <div class="ss-card card-plain">
          <div class="ss-card-features">
            <div class="ss-card-feature"><Icon name="search" class="feature-icon" /><h3>⌥⌘K, from anywhere</h3><p>Find a key by name and press Return. Try it here: type “stripe” or “codes”.</p></div>
            <div class="ss-card-feature"><Icon name="copy" class="feature-icon" /><h3>Private copies</h3><p>Clipboard history apps skip what Slinky copies, and it clears itself after a minute.</p></div>
            <div class="ss-card-feature"><Icon name="layers" class="feature-icon" /><h3>Shortcuts too</h3><p>Add to Slinky, Copy from Slinky with Touch ID, Quick Access and Lock, right in the Shortcuts app.</p></div>
          </div>
        </div>
      </div>

      <div class="ss-row is-rev reveal">
        <div class="ss-card card-plain">
          <div class="ss-card-features">
            <div class="ss-card-feature"><Icon name="touchid" class="feature-icon" /><h3>Opens with Touch ID</h3><p>Your vault is one encrypted file on your Mac, opened by the Secure Enclave.</p></div>
            <div class="ss-card-feature"><Icon name="lock" class="feature-icon" /><h3>Locks itself</h3><p>When your screen locks, when your Mac sleeps, when you’re away, and after 12 hours. Or flip the switch, top right.</p></div>
            <div class="ss-card-feature"><Icon name="shield" class="feature-icon" /><h3>A Recovery Key, on paper</h3><p>Opens your vault on any Mac if Touch ID can’t. Slinky never keeps a copy.</p></div>
          </div>
        </div>
        <Desktop><Demos which="lock" /></Desktop>
      </div>
    </section>

    <section class="section wrap" aria-labelledby="also-heading">
      <div class="section-head"><p class="eyebrow">Features</p><h2 class="section-title" id="also-heading">Also in Slinky</h2></div>
      <div class="features">
        <div class="feature card-plain"><Icon name="import" class="feature-icon" /><h3>Import</h3><p>Bring keys from 1Password, Apple Passwords, Bitwarden or a CSV. Passwords stay behind.</p></div>
        <div class="feature card-plain"><Icon name="gear" class="feature-icon" /><h3>Settings that matter</h3><p>When to lock, how long until the clipboard clears, sounds, open at login.</p></div>
        <div class="feature card-plain"><Icon name="update" class="feature-icon" /><h3>Updates in place</h3><p>One click, and only if the update is signed by Slinky’s developer.</p></div>
        <div class="feature card-plain"><Icon name="feather" class="feature-icon" /><h3>A {release.sizeMB} MB download</h3><p>Native Swift and Apple frameworks only. No web views, no dependencies.</p></div>
        <div class="feature card-plain"><Icon name="key" class="feature-icon" /><h3>AI agents, next</h3><p>Coming in 1.1: tools like Claude Code run your app with the real keys while only ever seeing dots.</p></div>
        <div class="feature card-plain"><Icon name="github" class="feature-icon" /><h3>Free and open source</h3><p>MIT licensed, made by Testament Made. Read every line on GitHub.</p></div>
      </div>
    </section>

    <section class="section wrap" id="compare" aria-labelledby="compare-heading">
      <div class="section-head"><p class="eyebrow">Compare</p><h2 class="section-title" id="compare-heading">Where Slinky fits</h2><p class="section-sub">Apple Passwords is great for logins. Slinky is for everything else you’re told to keep safe.</p></div>
      <div class="compare card-plain">
        <table>
          <thead><tr><th></th>{compare.cols.map((c, i) => <th class={i === 0 ? 'us' : ''} scope="col">{c}</th>)}</tr></thead>
          <tbody>
            {compare.rows.map(([label, cells]) => (
              <tr><th scope="row">{label}</th>{cells.map((v, i) => { const m = mark(v); return <td class={`${i === 0 ? 'us' : ''} ${m.cls}`}>{m.icon && <><Icon name={m.icon} /><span class="sr-only">{m.label}{m.note ? ': ' : ''}</span></>}{m.note && <span class="mk__note">{m.note}</span>}</td>; })}</tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="compare__note"><span class="compare__key"><span class="yes"><Icon name="checkc" /> Yes</span><span class="part"><Icon name="half" /> Partly</span><span class="no"><Icon name="dash" /> No</span></span> As of October 2026. Corrections welcome at help@slinkyfiles.com.</p>
    </section>

    <section class="cta-mid wrap">
      <h2 class="section-title">Give your secrets a home.</h2>
      <p class="cta-mid-sub">Free, about {release.sizeMB} MB, and nothing leaves your Mac.</p>
      <a class="btn btn--primary" href={release.dmg} data-download><Icon name="download" /> Download for Mac</a>
    </section>

    <section class="section wrap" id="privacy" aria-labelledby="privacy-heading">
      <div class="section-head"><p class="eyebrow">Privacy</p><h2 class="section-title" id="privacy-heading">Your things, in plain English</h2></div>
      <div class="plain">
        <div class="tile card-plain"><Icon name="shield" /><h3>Where they live</h3><ul><li>One encrypted file on your Mac.</li><li>Opened by your Mac’s Secure Enclave with Touch ID, or your printed Recovery Key.</li><li>Locked means the key isn’t in memory at all.</li></ul></div>
        <div class="tile card-plain"><Icon name="update" /><h3>What leaves your Mac</h3><ul><li>Nothing about you or your vault.</li><li>Once a day, a check with GitHub for a newer version. You can turn it off.</li><li>No account, no analytics in the app, no server.</li></ul></div>
      </div>
    </section>

    <section class="section wrap" id="faq" aria-labelledby="faq-heading">
      <div class="section-head"><p class="eyebrow">Questions</p><h2 class="section-title" id="faq-heading">Good to know</h2></div>
      <div class="faq">
        {faq.map(([q, a]) => <details class="card-plain"><summary>{q}</summary><p>{a}</p></details>)}
      </div>
    </section>
  </main>

  <FamilyTabs current="slinky" />

  <footer class="wrap">
    <p>© 2026 <a href="https://testamentmade.com">Testament Made, LLC</a> · <a href="mailto:help@slinkyfiles.com">help@slinkyfiles.com</a> · <a href="https://github.com/heyderekj/slinky">GitHub</a> · MIT License</p>
  </footer>

  <div class="modal" data-install role="dialog" aria-modal="true" aria-labelledby="install-title">
    <div class="modal__box">
      <button class="modal__close" type="button" data-close-install aria-label="Close">×</button>
      <h3 id="install-title">How to install Slinky</h3>
      <div class="tabs" role="tablist">
        <button role="tab" aria-selected="true" data-tab="dmg" type="button">Download &amp; install</button>
        <button role="tab" aria-selected="false" data-tab="brew" type="button">Homebrew</button>
      </div>
      <div data-panel="dmg">
        <ol>
          <li>Open <b>Slinky-{release.version}.dmg</b> and drag Slinky into Applications.</li>
          <li>Open Slinky. macOS says it can’t check it, because Slinky isn’t notarized yet.</li>
          <li>Open <b>System Settings › Privacy &amp; Security</b>, scroll down and click <b>Open Anyway</b>. Once is enough; updates install without asking again.</li>
        </ol>
        <p style="font-size:14.5px;color:var(--muted)">Still blocked? This command clears the download flag:</p>
        <div class="cmd"><code>xattr -dr com.apple.quarantine /Applications/Slinky.app</code><button type="button" data-copy-cmd>Copy</button></div>
      </div>
      <div data-panel="brew" hidden>
        <div class="cmd"><code>brew tap heyderekj/slinky https://github.com/heyderekj/slinky</code><button type="button" data-copy-cmd>Copy</button></div>
        <div class="cmd"><code>brew install --cask slinky</code><button type="button" data-copy-cmd>Copy</button></div>
      </div>
    </div>
  </div>
</Layout>
