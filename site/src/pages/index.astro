---
import { compare } from '../data/compare';
import Layout from '../layouts/Layout.astro';
import MacWindow from '../components/MacWindow.astro';
import Library from '../components/Library.astro';
import Demos from '../components/Demos.astro';
import Icon from '../components/SiteIcon.astro';
import AppIcon from '../components/Icon.astro';
import FamilyTabs from '../components/FamilyTabs.astro';
import Desktop from '../components/Desktop.astro';
import Guided from '../components/Guided.astro';
import Editorial from '../components/Editorial.astro';
import Monogram from '../components/Monogram.astro';
import InstallModals from '../components/InstallModals.astro';
import SiteFooter from '../components/SiteFooter.astro';
import CompareCell from '../components/CompareCell.astro';
import release from '../release.json';
import { faq, faqId } from '../data/faq';
const macosQuestion = 'Why does macOS say it can’t check Slinky?';
const core = ['Is Slinky free?', 'Where are my things stored?', 'Should I keep passwords in Slinky?', 'Why does macOS say it can’t check Slinky?'];
const faqSorted = [...faq.filter(([q]) => core.includes(q)), ...faq.filter(([q]) => !core.includes(q))];

const title = 'Slinky keeps secrets out of files.';
const description = 'A free, native Mac app for API keys, .env variables and recovery codes. Encrypted on your Mac and opened with Touch ID.';
const versionLine = `v${release.version} · ${release.minOS} · Apple silicon`;
---
<Layout title={`Slinky · ${title}`} description={description}>
  <nav class="nav float-glass is-tucked" aria-label="Slinky">
    <a class="nav__home" href="#top"><img src="/icons/slinky-320.webp" alt="" width="26" height="26" /> Slinky</a>
    <a class="nav__link" href="#features">Features</a>
    <a class="nav__link" href="#compare">Compare</a>
    <a class="nav__link" href="#privacy">Privacy</a>
    <a class="nav__link" href="#faq">FAQ</a>
    <a class="btn btn--quiet btn--small" href="https://github.com/heyderekj/slinky" data-stars aria-label="Slinky on GitHub"><Icon name="github" /><span class="star-count" data-star-count></span></a>
    <a class="btn btn--primary btn--small" href={release.dmg} data-download data-track="Download macOS nav">Download</a>
  </nav>

  <main id="top">
    <header class="hero wrap">
      <picture class="hero__icon">
        <source srcset="/icons/slinky-320-dark.webp" media="(prefers-color-scheme: dark)" />
        <img src="/icons/slinky-320.webp" alt="Slinky's app icon: a glass asterisk with a keyhole" width="128" height="128" />
      </picture>
      <h1>Slinky</h1>
      <p class="tagline">{title}</p>
      <p class="description">A Mac app that keeps API keys, .env variables and recovery codes out of files. Free and open source.</p>
      <div class="hero__actions">
        <a class="btn btn--primary" href={release.dmg} data-download data-track="Download macOS hero"><Icon name="apple" /> Download for Mac</a>
        <a class="btn btn--quiet" href="https://github.com/heyderekj/slinky" data-stars><Icon name="github" /> GitHub <span class="star-count" data-star-count></span></a>
      </div>
      <p class="hero__meta">{versionLine}<span class="version-sep"> · </span><button type="button" class="version-install-link" data-open-install>How to install</button></p>

      <Desktop class="desktop--hero" menubar>
        <div class="lockdemo" data-lockdemo data-mb-window>
          <MacWindow title="All Items" subtitle="7 items" selected="all" id="hero-window">
            <Library />
            <div slot="over" class="toast float-glass" data-toast><AppIcon name="checkc" /><span data-toast-text>Copied.</span></div>
            <div slot="over" class="curtain" aria-hidden="true">
              <div class="curtain__inner">
                <span class="curtain__lock" data-curtain-icon><AppIcon name="lock" /></span>
                <h4>Slinky is locked</h4>
                <button class="touchid" data-unlock type="button"><AppIcon name="touchid" /> Unlock with Touch ID</button>
              </div>
            </div>
          </MacWindow>
        </div>
      </Desktop>
      <div class="ss-trio">
        <div class="ss-card card-plain"><Icon name="key" class="feature-icon" /><h3>Keys &amp; Tokens</h3><p>API keys and access tokens your software and AI tools use, with expiry dates and live-key warnings.</p></div>
        <div class="ss-card card-plain"><Icon name="folder" class="feature-icon" /><h3>Projects</h3><p>Each app’s .env variables for Local, Preview and Production, out of the project folder.</p></div>
        <div class="ss-card card-plain"><Icon name="life" class="feature-icon" /><h3>Recovery</h3><p>Backup codes that cross themselves off, and recovery keys for the day you need them.</p></div>
      </div>
    </header>

    <section class="screenshots wrap" id="features" aria-label="What Slinky does">
      <Guided id="add" eyebrow="Add Item" title="Paste it once.<br />Slinky files it." features={[
        { icon: 'plus', title: 'Paste anything secret', text: 'Press ⌘N and paste. The value turns into dots right away, and Slinky suggests where it belongs.' },
        { icon: 'sparkle', title: 'Knows the service', text: 'Stripe, OpenAI, GitHub, Supabase, AWS and more, with the usual name filled in. Or pick where it lives yourself, like Cloudflare.' },
        { icon: 'attention', title: 'No accidental doubles', text: 'Paste something you’ve already saved and Slinky tells you where it is. Wallet phrases are refused.' },
      ]}>
        <Fragment slot="s0"><Demos which="additem" /></Fragment>
        <div slot="s1" class="additem is-ready" data-glass="panel">
          <div class="additem__top">Add Item <span class="xclose" aria-hidden="true">✕</span></div>
          <div class="slab"><div style="display:flex;gap:13px;align-items:flex-start"><Monogram text="Stripe" size={38} /><div><div class="slab__name">STRIPE_SECRET_KEY</div><div class="slab__value">sk_live_••••••••••••4f2a</div></div></div></div>
          <div class="detect"><AppIcon name="sparkle" style="width:14px;height:14px" /> Looks like a Stripe secret key, live mode.</div>
          <div class="chips"><span class="pchip"><AppIcon name="key" /> Key or Token <i class="caret">⌄</i></span><span class="chips__extras"><span><AppIcon name="calendar" /> Expiry</span><span>Link</span><span>Note</span></span></div>
          <div class="additem__foot"><span class="encnote"><AppIcon name="lock" /> Encrypted on this Mac</span> <span class="save">Save to Keys &amp; Tokens ↵</span></div>
        </div>
        <div slot="s2" class="additem is-ready" data-glass="panel">
          <div class="additem__top">Add Item <span class="xclose" aria-hidden="true">✕</span></div>
          <div class="slab"><div style="display:flex;gap:13px;align-items:flex-start"><Monogram text="GitHub" size={38} /><div><div class="slab__name">GITHUB_TOKEN</div><div class="slab__value">ghp_••••••••••••8c1d</div></div></div></div>
          <div class="detect" style="color:var(--app-amber)"><AppIcon name="attention" style="width:14px;height:14px" /> Already saved in Keys &amp; Tokens, as GITHUB_TOKEN.</div>
          <div class="chips"><span class="pchip"><AppIcon name="key" /> Key or Token <i class="caret">⌄</i></span></div>
          <div class="additem__foot"><span class="encnote"><AppIcon name="lock" /> Encrypted on this Mac</span> <span class="save">Save to Keys &amp; Tokens ↵</span></div>
        </div>
      </Guided>

      <Guided id="projects" eyebrow="Projects" title="Every project’s .env,<br />in one place." flip features={[
        { icon: 'folder', title: 'Drop the project folder', text: 'Slinky reads its .env files, apps inside it too, and shows what’s new, changed or the same in each environment. Only what you check is saved, and Undo takes it back.' },
        { icon: 'check', title: 'Every environment at a glance', text: 'Local, Preview and Production side by side, with what .env.example needs and Slinky doesn’t have yet. The Share menu copies an environment as .env lines, shares it with people, or sends it to your host.' },
        { icon: 'attention', title: 'Checks .gitignore', text: 'Files git could commit get a warning before they end up in your repo. Slinky never changes your files unless you ask.' },
      ]}>
        <div slot="s0" class="additem review is-ready" data-glass="panel">
          <div class="additem__top">Update from Folder <span class="xclose" aria-hidden="true">✕</span></div>
          <div class="slab rv__head"><Monogram text="harbor-app" size={38} /><div><div class="rv__title">harbor-app</div><div class="rv__path">~/Developer/harbor-app <span class="chip chip--plain">git</span></div></div></div>
          <div class="rv__sec"><b>Local</b> · from .env, .env.local · 3 new, 1 changed</div>
          <div class="rv__rows">
            <div class="rv__row"><span class="rv__box is-on"><AppIcon name="check" /></span><span class="rv__name">RESEND_API_KEY</span><span class="chip chip--new">New</span><span class="rv__peek">re_••••7d0e</span></div>
            <div class="rv__row"><span class="rv__box is-on"><AppIcon name="check" /></span><span class="rv__name">STRIPE_SECRET_KEY</span><span class="chip chip--warn">Changed</span><span class="rv__peek">sk_test_••••4f2a → ••••9b1c</span></div>
            <div class="rv__row"><span class="rv__box is-on"><AppIcon name="check" /></span><span class="rv__name">POSTHOG_KEY</span><span class="chip chip--new">New</span><span class="rv__peek">phc_••••0aa1</span></div>
            <div class="rv__row is-off"><span class="rv__box"></span><span class="rv__name">UPSTASH_TOKEN</span><span class="rv__note">Empty in .env.local</span></div>
          </div>
          <div class="rv__quiet">5 unchanged · 2 only in Slinky. They stay as they are.</div>
          <div class="additem__foot"><span class="encnote"><AppIcon name="lock" /> Encrypted on this Mac</span> <span class="save">Update 3 Variables ↵</span></div>
        </div>
        <Fragment slot="s1"><Demos which="env" /></Fragment>
        <div slot="s2" class="additem review is-ready" data-glass="panel">
          <div class="additem__top">Files</div>
          <div class="rv__rows">
            <div class="rv__row rv__row--file"><span class="rv__box is-on"><AppIcon name="check" /></span><span class="rv__name">.env</span><span class="rv__note">4 new, 1 changed</span><span class="pchip pchip--sm">Local <i class="caret">⌄</i></span></div>
            <div class="rv__row rv__row--file"><span class="rv__box is-on"><AppIcon name="check" /></span><span class="rv__name">.env.production <span class="chip chip--warn">Not in .gitignore</span></span><span class="rv__note">2 new</span><span class="pchip pchip--sm">Production <i class="caret">⌄</i></span></div>
            <div class="rv__row rv__row--file"><span class="rv__box is-on"><AppIcon name="check" /></span><span class="rv__name">apps/web/.env.local</span><span class="rv__note">2 new</span><span class="pchip pchip--sm">Local <i class="caret">⌄</i></span></div>
          </div>
          <div class="detect" style="color:var(--app-amber)"><AppIcon name="attention" style="width:14px;height:14px" /> Git could commit .env.production. Slinky won’t change your files; add it to .gitignore.</div>
        </div>
      </Guided>

      <Guided id="recovery" eyebrow="Recovery" title="Backup codes<br />that keep count." features={[
        { icon: 'hash', title: 'Codes that cross themselves off', text: 'Copy a backup code and it’s marked used, so you never try one twice.' },
        { icon: 'heart', title: 'Health keeps watch', text: 'One view for codes running out, keys about to expire, recovery keys never printed, and keys left in files.' },
        { icon: 'life', title: 'Recovery keys, kept safe', text: 'For the day you’re locked out of an account. Print them from Slinky in one click.' },
      ]}>
        <Fragment slot="s0">
          <div class="additem" data-glass="panel" style="max-width:380px">
            <div class="card" data-codeset>
              <div class="card__head">
                <Monogram text="Vercel" size={30} />
                <div><div class="card__kind">Recovery codes</div><div class="card__name">Vercel</div><div class="card__sub">harbor@example.com</div></div>
                <div class="left is-low"><b data-left>4</b><small>left</small></div>
              </div>
              <div class="codes">
                {['b8x2k-4mq9t', 'n3v7p-1zr5w', 'c6h4d-8yt2e', 'p9k1s-5qx7m'].map((c) => <button class="code" data-code>{c}</button>)}
                {['t2w6r-9bn3j', 'f5m8c-2kd4x'].map((c) => <span class="code is-used">{c}<AppIcon name="check" class="tick" /></span>)}
              </div>
            </div>
            <p class="detect" style="margin-top:12px"><AppIcon name="attention" style="width:14px;height:14px;color:var(--app-amber)" /> Only 4 codes left. Click one to copy it.</p>
          </div>
        </Fragment>
        <div slot="s1" class="additem health" data-glass="panel" style="max-width:440px">
          <div class="health__sum">
            <svg class="health__ring" viewBox="0 0 100 100" aria-hidden="true">
              {[0,1,2,3,4,5,6,7].map((i) => {
                const gap = 0.018, a0 = (i / 8 + gap) * 2 * Math.PI - Math.PI / 2, a1 = ((i + 1) / 8 - gap) * 2 * Math.PI - Math.PI / 2;
                const p = (a: number) => `${(50 + 42 * Math.cos(a)).toFixed(2)} ${(50 + 42 * Math.sin(a)).toFixed(2)}`;
                return <path d={`M ${p(a0)} A 42 42 0 0 1 ${p(a1)}`} class={i === 3 || i === 4 ? 'is-found' : 'is-ok'} />;
              })}
              <text x="50" y="61" text-anchor="middle">2</text>
            </svg>
            <div><b>2 things to look at</b><small>Checked just now, on this Mac.</small></div>
          </div>
          <div class="health__tiles">
            <div class="health__tile"><AppIcon name="folder" /><b>Project files</b><span class="ok">Clear</span></div>
            <div class="health__tile"><AppIcon name="layers" /><b>AI conversations</b><span class="ok">Clear</span></div>
            <div class="health__tile"><AppIcon name="terminal" /><b>Shell history</b><span class="ok">Clear</span></div>
            <div class="health__tile is-found"><AppIcon name="calendar" /><b>Expiring keys</b><span class="found">1 found</span></div>
            <div class="health__tile is-found"><AppIcon name="hash" /><b>Recovery codes</b><span class="found">1 found</span></div>
            <div class="health__tile"><AppIcon name="life" /><b>Printed copies</b><span class="ok">Clear</span></div>
          </div>
          <div class="att">
            <div class="att__row"><AppIcon name="hash" /><div><b>Only 4 Vercel codes left</b><small>Make new recovery codes on Vercel, then add them here.</small></div></div>
            <div class="att__row"><AppIcon name="calendar" /><div><b>GITHUB_TOKEN expires in 5 days</b><small>Make a new one on GitHub, then replace it here.</small></div></div>
          </div>
        </div>
        <div slot="s2" class="additem" data-glass="panel" style="max-width:400px">
          <div class="card">
            <div class="card__head"><Monogram text="Apple Account" /><div><div class="card__kind">Recovery key</div><div class="card__name">Apple Account recovery key</div><div class="card__sub">From Apple</div></div></div>
            <div class="card__value"><span>R7KQ-••••-••••-••••</span></div>
            <div class="card__foot"><span class="chip">Printed</span><span style="margin-left:auto;display:flex;gap:6px"><span class="copy">Print</span><span class="copy"><AppIcon name="copy" /> Copy</span></span></div>
          </div>
        </div>
      </Guided>

      <Editorial eyebrow="Quick Access" title="Your keys,<br />a shortcut away." flip features={[
        { icon: 'search', title: '⌥⌘K, from anywhere', text: 'Find a key by name and press Return. Try it here: type “stripe” or “codes”.' },
        { icon: 'copy', title: 'Private copies', text: 'Clipboard history apps skip what Slinky copies, and it clears itself after a minute.' },
        { icon: 'layers', title: 'Shortcuts too', text: 'Add to Slinky, Copy from Slinky with Touch ID, Quick Access and Lock, right in the Shortcuts app.' },
      ]}>
        <Demos which="quick" />
      </Editorial>

      <Guided id="lock" eyebrow="Locking" title="Locked unless<br />you’re using it." features={[
        { icon: 'touchid', title: 'Opens with Touch ID', text: 'Your vault is one encrypted file on your Mac, opened by the Secure Enclave. On macOS 26 and later, the key that opens it is locked with both a classic and a post-quantum key.' },
        { icon: 'lock', title: 'Locks itself', text: 'When your screen locks, when your Mac sleeps, when you’re away, and after 12 hours. Or flip the switch, top right, or use Lock Slinky in Control Center.' },
        { icon: 'shield', title: 'A Recovery Key, on paper', text: 'Opens your vault on any Mac if Touch ID can’t. Slinky never keeps a copy.' },
      ]}>
        <div slot="s0" class="touch" data-glass="panel">
          <span class="touch__fp"><AppIcon name="touchid" /></span>
          <h4>Slinky</h4>
          <p>Slinky wants to unlock your vault.<br />Touch ID or enter your password to allow this.</p>
          <span class="touch__btn">Use Password…</span>
        </div>
        <Fragment slot="s1"><Demos which="lock" /></Fragment>
        <div slot="s2" class="paper">
          <h4>Slinky Recovery Key</h4>
          <p>You need this key to open your vault on another Mac, or if Touch ID stops working. Slinky doesn’t keep a copy.</p>
          <div class="paper__key">EXMP-7K2Q-4MXP-9TRB-6WZD</div>
          <p>Keep it somewhere safe, away from your Mac.</p>
        </div>
      </Guided>

      <Guided id="sync" eyebrow="Sync" title="Your vault,<br />on each of your Macs." flip features={[
        { icon: 'folder', title: 'A folder you choose', text: 'Pick one your sync service keeps everywhere, like iCloud Drive or Dropbox. Slinky puts an encrypted copy of your vault there, and sends nothing itself.' },
        { icon: 'shield', title: 'Your Recovery Key, once', text: 'On your other Mac, choose the same folder and enter your Recovery Key. The copy opens only with that key or on a Mac you’ve set up.' },
        { icon: 'update', title: 'Changes come together', text: 'Edit on either Mac. The newer change to each item wins, and something deleted stays deleted.' },
      ]}>
        <div slot="s0" class="additem sync is-ready" data-glass="panel">
          <div class="additem__top">Sync</div>
          <div class="pane__rows">
            <div class="pane__row"><span>Folder</span><b class="mono-path">iCloud Drive › Slinky</b></div>
            <div class="pane__row"><span>Status</span><b>Synced 2 min ago · iCloud Drive</b></div>
          </div>
          <div class="sync__buttons"><span class="copy">Sync Now</span><span class="copy" style="color:var(--red)">Stop Syncing</span></div>
          <p class="sync__note">An encrypted copy of your vault, moved by your sync service. It opens only with your Recovery Key or on a Mac you’ve set up. It’s also a backup.</p>
        </div>
        <div slot="s1" class="additem sync is-ready" data-glass="panel">
          <div class="additem__top">Use the vault in this folder</div>
          <p class="sync__note" style="margin-top:0">This folder already has a Slinky vault, from your other Mac. Enter its Recovery Key to use it here. This Mac’s items are added to it.</p>
          <div class="card__value" style="height:34px"><span>••••-••••-••••-••••-••••</span></div>
          <div class="additem__foot"><span class="encnote"><AppIcon name="lock" /> Encrypted on this Mac</span> <span class="save">Use This Vault ↵</span></div>
        </div>
        <div slot="s2" class="sync__macs">
          {[['MacBook Air', 'Just now'], ['Mac Studio', 'Just now']].map(([mac, when]) => (
            <div class="additem sync sync__mac" data-glass="panel">
              <div class="sync__device"><AppIcon name="update" /> {mac}</div>
              <div class="lib__row is-on"><Monogram text="Stripe" size={32} /><div class="lib__text"><div class="lib__name mono">STRIPE_SECRET_KEY</div><div class="lib__sub">Changed {when.toLowerCase()}</div></div><span class="chip chip--live">Live</span></div>
              <div class="lib__row"><Monogram text="GitHub" size={32} /><div class="lib__text"><div class="lib__name mono">GITHUB_TOKEN</div><div class="lib__sub">GitHub</div></div></div>
            </div>
          ))}
        </div>
      </Guided>

      <Guided id="share" eyebrow="Sharing" title="Share keys with your team.<br />No server in between." features={[
        { icon: 'people', title: 'Share with…', text: 'Pick the people, and Slinky makes a .slinkyshare file only their Macs can open. Send it any way you like: AirDrop, Messages, Mail or a chat.' },
        { icon: 'check', title: 'Compare codes once', text: 'Each Mac has a sharing card in People (⌘8). Add someone’s card, then read your codes to each other on a call or in person. They should match exactly.' },
        { icon: 'folder', title: 'Shared projects', text: 'Share › Share Project with Team… keeps one signed, encrypted .slinkyproject file in a folder your team already syncs. Remove someone, and Slinky makes a new key and lists the keys to replace.' },
      ]}>
        <Fragment slot="s0"><Demos which="share" /></Fragment>
        <Fragment slot="s1"><Demos which="people" /></Fragment>
        <Fragment slot="s2"><Demos which="team" /></Fragment>
      </Guided>

      <Editorial eyebrow="AI agents" title="Agents use your keys.<br />They never see them." flip features={[
        { icon: 'terminal', title: 'slinky run', text: 'Claude Code, Cursor and Codex start your app through slinky run. You approve each command with Touch ID, and the keys never reach the chat.' },
        { icon: 'sparkle', title: 'Names, never values', text: 'Connected agents can list names and ask for what’s missing. Live keys stay out, and so do shells and tools that send things off your Mac.' },
        { icon: 'plusc', title: 'Paste it here, not in the chat', text: 'When an agent needs a key Slinky doesn’t have, Slinky opens with the name filled in, for you to paste.' },
      ]}>
        <div class="agent-demo">
          <pre class="agent-term" aria-hidden="true"><span>&gt; start the dev server</span>
⏺ Bash(slinky run -- npm run dev)
  ✓ started with 4 secrets from Acme
  STRIPE_SECRET_KEY=••••••••</pre>
          <div class="touch" data-glass="panel">
            <span class="touch__fp"><AppIcon name="touchid" /></span>
            <h4>Slinky</h4>
            <p>Slinky wants to let Claude Code run “npm run dev” with 4 secrets from Acme.</p>
            <span class="touch__btn">Use Password…</span>
          </div>
        </div>
      </Editorial>
    </section>

    <section class="section wrap" aria-labelledby="also-heading">
      <div class="section-head"><p class="eyebrow">Features</p><h2 class="section-title" id="also-heading">Also in Slinky</h2></div>
      <div class="b-grid">
        <div class="b-tile b-tile--wide card-plain">
          <div><Icon name="import" class="feature-icon" /><h3>Import</h3><p>Bring keys from 1Password, Apple Passwords, Bitwarden, LastPass, KeePass or a CSV, even ones in notes. Rename them first, and Undo takes it all back. Passwords stay behind.</p></div>
          <div class="b-art b-import" aria-hidden="true">
            {[['1Password', '24 keys'], ['Apple Passwords', '9 keys'], ['Bitwarden', '12 keys'], ['LastPass', '7 keys'], ['KeePass', '5 keys']].map(([n, c], i) => (
              <div class="b-src"><Monogram text={n} size={24} /><b>{n}</b><small>{c}</small></div>
            ))}
            <p class="b-note">31 passwords left behind</p>
          </div>
        </div>
        <div class="b-tile card-plain"><Icon name="feather" class="feature-icon" /><h3>Small and native</h3><p>Native Swift and Apple frameworks only. No web views, no dependencies.</p><p class="b-big">{release.sizeMB}<span>MB</span></p></div>
        <div class="b-tile card-plain"><Icon name="update" class="feature-icon" /><h3>Updates in place</h3><p>One click, and only if the update is signed by Slinky’s developer.</p>
          <div class="b-art b-update" aria-hidden="true"><span>Slinky {release.version}</span><span class="b-pill">Up to date</span></div></div>
        <div class="b-tile b-tile--wide b-tile--dark card-plain">
          <div><Icon name="key" class="feature-icon" /><h3>The slinky command</h3><p>Run your app with a project’s variables after Touch ID, with no .env on disk. Write a names-only .env.example, open an item, or lock Slinky from the terminal.</p></div>
          <pre class="b-art b-term" aria-hidden="true">$ slinky run -- npm start
✓ started with 4 keys
$ slinky example
Wrote .env.example with 12 names and no values.
$ slinky lock</pre>
        </div>
        <div class="b-tile b-tile--wide card-plain">
          <div><Icon name="cloudup" class="feature-icon" /><h3>Make a new key, send it where it runs</h3><p>“Make New Key on GitHub…” opens the right page and replaces it everywhere it’s used. Send a project’s variables to Vercel, Netlify, Cloudflare or Fly through their own tools.</p></div>
          <div class="b-art b-import" aria-hidden="true">
            {[['Vercel', 'Production'], ['Netlify', 'All deploys'], ['Cloudflare', 'Workers, Pages'], ['Fly.io', 'acme-api']].map(([n, c], i) => (
              <div class="b-src"><Monogram text={n} size={24} /><b>{n}</b><small>{c}</small></div>
            ))}
            <p class="b-note">Values go on stdin, never in the command line</p>
          </div>
        </div>
        <div class="b-tile card-plain"><Icon name="heart" class="feature-icon" /><h3>Health</h3><p>Finds your saved keys where they shouldn’t be, with one-click fixes and a check before each commit.</p>
          <div class="b-art b-settings" aria-hidden="true"><div><span>.env in acme-web</span><b>Move into Slinky</b></div><div><span>A Claude Code conversation</span><b>Make a new key</b></div></div></div>
        <div class="b-tile card-plain"><Icon name="file" class="feature-icon" /><h3>Apple developer files</h3><p>App Store Connect .p8 keys, certificates and service accounts, in the vault. Save a notarytool profile without the .p8 lying around.</p></div>
        <div class="b-tile card-plain"><Icon name="clock" class="feature-icon" /><h3>Activity</h3><p>What was copied or run, when, and by whom. Names only, kept in your vault.</p>
          <div class="b-art b-settings b-log" aria-hidden="true"><div><span><b>Claude Code</b> ran npm run dev</span><small>2 min ago</small></div><div><span><b>You</b> copied STRIPE_SECRET_KEY</span><small>1 hr ago</small></div></div></div>
        <div class="b-tile card-plain"><Icon name="grid" class="feature-icon" /><h3>Made for the keyboard</h3><p>⌘1 to ⌘8 for each place, ⌘E to edit, ⇧⌘C to copy as NAME=value. Select several to change them together.</p>
          <div class="b-art b-kb" aria-hidden="true">
            <span class="kkey kkey--wide">⌘</span>
            {['1', '2', '3', '4', '5', '6', '7', '8'].map((k, i) => <span class:list={['kkey', { 'is-down': i === 0 }]}>{k}</span>)}
          </div>
        </div>
        <div class="b-tile b-tile--wide b-tile--full card-plain">
          <div><Icon name="apple" class="feature-icon" /><h3>Ready for macOS 27</h3><p>Slinky’s menu bar menu works like the menus beside it, from the keyboard too. Lock Slinky from Control Center or the menu bar (macOS 26 and later). In Shortcuts, Copy from Slinky and Add to Slinky run only in Slinky itself.</p></div>
          <div class="b-art b-settings" aria-hidden="true"><div><span>Control-F8, then the arrow keys</span><b>Slinky’s menu</b></div><div><span>Lock Slinky</span><b>Control Center</b></div><div><span>Copy from Slinky</span><b>Runs in Slinky</b></div></div>
        </div>
        <div class="b-tile b-tile--row card-plain"><Icon name="github" class="feature-icon" /><div><h3>Free and open source</h3><p>MIT licensed, made by Testament Made. Read every line on GitHub.</p></div><a class="b-pill b-pill--gh" href="https://github.com/heyderekj/slinky"><Icon name="github" /> heyderekj/slinky <span class="star-count" data-star-count></span></a></div>
      </div>
    </section>

    <section class="section wrap" id="compare" aria-labelledby="compare-heading">
      <div class="section-head"><p class="eyebrow">Compare</p><h2 class="section-title" id="compare-heading">Where Slinky fits</h2><p class="section-sub">Apple Passwords is great for logins. Slinky is for everything else you’re told to keep safe.</p></div>
      <div class="compare card-plain">
        <table>
          <thead><tr><th></th>{compare.cols.map((c, i) => <th class={i === 0 ? 'us' : ''} scope="col">{c}</th>)}</tr></thead>
          <tbody>
            {compare.rows.map(([label, cells]) => (
              <tr><th scope="row">{label}</th>{cells.map((v, i) => <CompareCell v={v} us={i === 0} />)}</tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="compare__note"><span class="compare__key"><span class="yes"><Icon name="checkc" /> Yes</span><span class="part"><Icon name="half" /> Partly</span><span class="no"><Icon name="dash" /> No</span></span> <span>As of October 2026.</span> <a class="compare__more" href="/compare/">Full comparisons</a></p>
    </section>

    {/* The download, as a quiet strip between hairlines: icon and words on the left, the button on the right. */}
    <section class="get wrap" aria-labelledby="get-heading">
      <div class="get__strip">
        <img src="/icons/slinky-320.webp" alt="" width="64" height="64" />
        <div class="get__copy"><h2 id="get-heading">Give your secrets a home.</h2><p>Free, about {release.sizeMB} MB, and nothing leaves your Mac.</p></div>
        <div class="get__act"><a class="btn btn--primary" href={release.dmg} data-download data-track="Download macOS mid"><Icon name="apple" /> Download for Mac</a><small>v{release.version} · {release.minOS} · Apple silicon</small></div>
      </div>
    </section>

    <section class="section wrap" id="privacy" aria-labelledby="privacy-heading">
      <div class="section-head"><p class="eyebrow">Privacy</p><h2 class="section-title" id="privacy-heading">Your things, in plain English</h2></div>
      <div class="plain">
        <div class="tile"><Icon name="shield" /><h3>Where they live</h3><ul><li>One encrypted file on your Mac.</li><li>Opened by your Mac’s Secure Enclave with Touch ID, or your printed Recovery Key.</li><li>On macOS 26 and later, the key that opens it is locked twice: with a classic key and a post-quantum one (P-256 and ML-KEM-768). An older vault moves over the next time you unlock it.</li><li>Locked means the key isn’t in memory at all.</li><li>Optional sync: an encrypted copy in a folder you choose, moved by your own sync service.</li></ul></div>
        <div class="tile"><Icon name="update" /><h3>What leaves your Mac</h3><ul><li>Nothing about you or your vault.</li><li>Once a day, a check with GitHub for a newer version. You can turn it off.</li><li>Only if you turn it on, a request to each saved website for its icon.</li><li>When you choose Send to Host, the values you pick go to that host, through its own tool.</li><li>When you share, Slinky makes a signed, encrypted file only the people you pick can open (on macOS 26 and later, with the same post-quantum lock and ML-DSA-65 signatures). You send it, or your team’s own sync service moves it. Slinky makes no request for it.</li><li>No account, no analytics in the app, no server.</li></ul></div>
      </div>
    </section>

    <section class="section wrap" id="faq" aria-labelledby="faq-heading">
      <div class="section-head"><p class="eyebrow">Questions</p><h2 class="section-title" id="faq-heading">Good to know</h2></div>
      {/* Ask anything: answered from this page's own words (public/family-ask.js → functions/api/ask.js). */}
      <form class="fask" data-ask role="search">
        <label class="fask__field"><span class="fmb-orb" aria-hidden="true"></span><input name="q" type="text" placeholder="Ask a question about Slinky" aria-label="Ask a question about Slinky" maxlength="280" autocomplete="off" spellcheck="false" /></label>
      </form>
      <div class="fask__answer" data-ask-answer hidden><span class="fmb-orb" aria-hidden="true"></span><div><p data-ask-text aria-live="polite"></p><p data-ask-src hidden></p></div></div>
      {/* A few core questions first; the rest behind "Show all", since the ask field answers anything. */}
      <div class="faq" data-faq-collapsed>
        {faqSorted.map(([q, a]) => <details class:list={['card-plain', { 'faq-more': !core.includes(q) }]} id={faqId(q)}><summary>{q}</summary><p>{a}{q === macosQuestion && <> <button type="button" class="faq-fix" data-open-help>How to fix it →</button></>}</p></details>)}
      </div>
      <button type="button" class="faq-all" data-faq-all>Show all {faq.length} questions</button>
    </section>
  </main>

  <FamilyTabs current="slinky" />

  <SiteFooter />

  <InstallModals />
</Layout>
