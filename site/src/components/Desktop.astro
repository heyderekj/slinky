---
// A little Mac screen: the mesh wallpaper inside a rounded frame, with a Tahoe menu bar along the top.
// The menu bar is clear (no bar), text sits on the wallpaper, items get a rounded highlight on hover,
// and the status items are in macOS's order: app extras, battery, Wi-Fi, Spotlight, Control Center, clock.
interface Props { class?: string; app?: string; menubar?: boolean }
const { class: cls = '', app = 'Slinky', menubar = false } = Astro.props;
---
<div class={`desktop ${cls}`} data-desktop>
  {menubar && <div class="menubar" aria-hidden="true">
    <span class="mb-item mb-apple"><svg viewBox="0 0 520 640" width="13" height="16" aria-hidden="true"><path fill="currentColor" transform="translate(0 640) scale(1 -1)" d="M356 599 c-27 -3 -61 -24 -79 -47 -17 -23 -28 -55 -25 -75 l0 -6 6 0 c45 0 91 41 103 92 2 10 4 34 2 36 0 0 -3 0 -7 0z M345 464 c-16 -2 -31 -6 -53 -14 -37 -14 -35 -14 -74 0 -10 4 -23 8 -28 10 -63 15 -132 -27 -154 -96 -15 -45 -13 -108 6 -164 7 -20 25 -61 31 -70 1 -1 7 -10 12 -19 46 -69 76 -83 129 -58 20 9 33 11 55 11 17 -1 22 -2 42 -11 20 -9 27 -10 42 -10 19 -1 29 3 45 16 12 9 15 13 32 35 19 26 37 58 46 84 l4 12 -9 4 c-14 7 -35 26 -45 40 -14 21 -21 43 -20 70 0 40 19 77 53 101 4 3 6 5 5 6 -5 9 -24 27 -37 34 -23 14 -59 22 -82 19z"/></svg></span>
    <span class="mb-item mb-app">{app}</span>
    <span class="mb-item">File</span><span class="mb-item">Edit</span><span class="mb-item">View</span>
    <span class="mb-item mb-more">Window</span><span class="mb-item mb-more">Help</span>
    <span class="mb-right">
      <span class="mb-item mb-icon" title="Slinky">
        <svg viewBox="0 0 18 18" width="18" height="18" aria-hidden="true"><defs><mask id="mb-slinky-hole" maskUnits="userSpaceOnUse" x="0" y="0" width="18" height="18"><rect width="18" height="18" fill="#fff"/><circle cx="9" cy="8.19" r="0.93"/><rect x="8.575" y="8.84" width="0.85" height="1.95"/></mask></defs><g mask="url(#mb-slinky-hole)" stroke="currentColor" stroke-width="2.6" stroke-linecap="round"><path d="M9.724 3.85 8.276 14.15M4.902 5.798l8.196 6.404M4.179 10.948l9.642-3.896"/></g></svg>
      </span>
      {/* Battery, Wi-Fi, Spotlight and Control Center: SF Symbols traced at the menu bar's 13 pt. */}
      <span class="mb-item mb-icon mb-more"><svg viewBox="0 0 880 440" width="22" height="11" aria-hidden="true"><path fill="currentColor" transform="translate(0 440) scale(1 -1)" d="M187 399 c-68 -3 -101 -33 -108 -98 -2 -16 -2 -149 0 -162 8 -61 35 -90 91 -97 14 -2 447 -2 462 0 53 7 81 35 90 91 2 14 3 135 1 158 -5 67 -32 98 -91 107 -10 1 -30 1 -220 2 -115 0 -216 -1 -225 -1z m440 -44 c38 -6 53 -24 57 -68 2 -20 1 -136 -1 -147 -7 -34 -21 -48 -52 -55 -8 -1 -21 -1 -231 -1 l-222 0 -10 2 c-32 7 -46 24 -50 65 -3 19 -3 117 0 137 5 47 21 64 65 68 16 1 435 1 444 -1z M171 325 c-15 -4 -23 -14 -25 -33 -1 -12 -1 -133 0 -145 2 -21 12 -31 32 -33 11 -1 434 -1 445 0 20 2 29 11 32 32 2 14 1 149 -1 156 -4 13 -12 20 -25 23 -9 2 -451 1 -458 0z M758 220 l0 -69 3 1 c13 2 29 18 36 36 12 30 6 65 -15 87 -5 6 -17 13 -22 13 l-2 0 0 -68z"/></svg></span>
      <span class="mb-item mb-icon"><svg viewBox="0 0 680 520" width="17" height="13" aria-hidden="true"><path fill="currentColor" transform="translate(0 520) scale(1 -1)" d="M310 479 c-35 -3 -69 -10 -106 -23 -54 -19 -107 -52 -145 -92 -17 -17 -20 -22 -17 -28 1 -3 38 -42 41 -44 6 -3 10 -1 16 5 57 59 123 92 202 102 29 3 74 2 101 -4 52 -11 90 -27 130 -55 14 -10 22 -17 40 -35 15 -14 17 -15 22 -13 4 1 42 40 44 44 2 5 0 9 -7 17 -42 48 -104 88 -170 108 -8 2 -16 5 -17 5 -28 10 -94 16 -134 13z M318 325 c-28 -2 -66 -12 -90 -23 -32 -16 -66 -41 -81 -62 -6 -8 -6 -8 21 -35 28 -30 28 -30 45 -13 29 29 64 46 105 52 14 2 43 1 57 -2 36 -8 65 -24 91 -50 18 -17 17 -17 43 10 27 27 26 26 26 31 0 3 -1 5 -6 11 -24 29 -61 53 -100 66 -38 13 -74 18 -111 15z M333 170 c-32 -3 -54 -14 -73 -35 -7 -8 -9 -12 -7 -16 1 -3 14 -15 51 -52 29 -28 33 -31 44 -25 7 4 76 73 78 77 2 6 0 10 -9 19 -19 19 -40 29 -67 32 -10 1 -12 1 -17 0z"/></svg></span>
      <span class="mb-item mb-icon"><svg viewBox="0 0 640 600" width="16" height="15" aria-hidden="true"><path fill="currentColor" transform="translate(0 600) scale(1 -1)" d="M250 559 c-93 -7 -174 -69 -200 -155 -10 -35 -8 -92 4 -119 1 -3 3 -9 5 -13 22 -53 75 -101 133 -120 44 -14 94 -16 139 -4 21 5 49 17 66 28 l3 3 4 -3 c2 -2 8 -8 14 -13 6 -6 19 -18 30 -28 10 -10 23 -22 28 -26 5 -5 18 -17 28 -27 11 -10 24 -22 29 -27 13 -12 18 -14 31 -14 8 0 10 0 15 2 14 7 21 23 16 39 -2 5 -4 7 -22 24 -7 7 -22 20 -32 30 -10 10 -24 23 -31 29 -8 7 -18 17 -23 22 -5 4 -13 11 -16 15 -12 11 -22 20 -22 21 0 0 1 2 3 4 9 10 26 40 32 58 17 52 14 106 -11 154 -5 11 -17 30 -20 33 -1 1 -5 6 -10 12 -21 23 -49 44 -78 56 -6 2 -12 5 -13 5 -23 10 -69 17 -102 14z m47 -46 c47 -8 89 -31 116 -67 32 -41 42 -95 26 -145 -24 -73 -105 -124 -187 -116 -78 8 -141 60 -157 133 -10 43 2 93 31 129 40 51 105 75 171 66z"/></svg></span>
      <span class="mb-item mb-icon"><svg viewBox="0 0 640 560" width="16" height="14" aria-hidden="true"><path fill="currentColor" transform="translate(0 560) scale(1 -1)" d="M176 518 c-60 -9 -101 -56 -101 -115 0 -14 3 -32 8 -41 1 -3 3 -8 4 -10 13 -31 49 -56 88 -62 16 -3 285 -2 296 0 43 11 71 35 86 73 5 12 6 19 7 36 1 24 -2 35 -12 57 -16 33 -47 55 -86 61 -10 2 -279 3 -290 1z m290 -40 c28 -8 48 -27 55 -53 11 -44 -12 -84 -56 -96 l-8 -2 -137 0 -137 0 -9 2 c-37 10 -58 37 -58 74 0 40 25 70 66 77 2 0 66 1 141 1 135 -1 136 -1 143 -3z M184 463 c-30 -5 -50 -29 -50 -58 -1 -34 21 -57 55 -61 16 -2 91 -1 99 1 33 9 52 41 43 75 -5 22 -24 38 -46 43 -9 1 -92 2 -101 0z M175 248 c-50 -5 -88 -36 -98 -80 -2 -11 -2 -36 0 -47 9 -39 40 -69 83 -79 13 -2 306 -3 319 0 52 12 85 51 85 103 0 51 -33 90 -86 102 -7 1 -21 1 -153 2 -81 0 -148 0 -150 -1z m298 -39 c33 -7 53 -31 53 -64 0 -31 -16 -53 -45 -63 l-7 -2 -51 -1 c-58 0 -60 0 -75 7 -16 8 -28 22 -33 37 -4 11 -4 33 0 43 7 22 27 38 51 43 8 1 99 1 107 0z"/></svg></span>
      <span class="mb-item mb-clock" data-clock>Fri Oct 17&nbsp;&nbsp;9:41 AM</span>
    </span>
  </div>}
  <div class="desktop__stage"><slot /></div>
</div>
