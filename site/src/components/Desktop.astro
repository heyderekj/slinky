---
// A little Mac screen: the mesh wallpaper (drawn by scripts/glass.ts) inside a rounded frame, with a
// menu bar along the top. The recreated Slinky UI sits on it, the way the app sits on your desktop.
interface Props { class?: string; app?: string }
const { class: cls = '', app = 'Slinky' } = Astro.props;
---
<div class={`desktop ${cls}`} data-desktop>
  <div class="menubar" aria-hidden="true">
    <b>{app}</b><span>File</span><span>Edit</span><span>View</span><span class="menubar__more">Window</span><span class="menubar__more">Help</span>
    <span class="menubar__right">
      <svg viewBox="0 0 18 18" width="15" height="15" class="menubar__slinky"><g stroke="currentColor" stroke-width="2.6" stroke-linecap="round"><path d="M9.9 2.7 8.1 15.3M3.4 6.3l11.2 5.4M3.6 12.1l10.8-6.2"/></g><circle cx="9" cy="8.6" r="1.25" fill="var(--menubar-hole)"/><rect x="8.55" y="8.6" width=".9" height="2.2" fill="var(--menubar-hole)"/></svg>
      <svg viewBox="0 0 20 14" width="17" height="12"><path fill="currentColor" d="M10 2.5c2.6 0 5 1 6.8 2.7l1.2-1.3A11.6 11.6 0 0 0 10 .7 11.6 11.6 0 0 0 2 3.9l1.2 1.3A9.8 9.8 0 0 1 10 2.5Zm0 3.7c1.6 0 3.1.6 4.2 1.7l1.2-1.3A7.8 7.8 0 0 0 10 4.4c-2.1 0-4 .8-5.4 2.2l1.2 1.3A6 6 0 0 1 10 6.2Zm0 3.6c.7 0 1.3.3 1.8.7L10 12.4l-1.8-1.9c.5-.4 1.1-.7 1.8-.7Z"/></svg>
      <span>Fri Oct 17&nbsp;&nbsp;9:41 AM</span>
    </span>
  </div>
  <div class="desktop__stage"><slot /></div>
</div>
