---
// A little Mac screen: the mesh wallpaper inside a rounded frame, with a Tahoe menu bar along the top.
// The menu bar is clear (no bar), text sits on the wallpaper, items get a rounded highlight on hover,
// and the status items are in macOS's order: app extras, battery, Wi-Fi, Spotlight, Control Center, clock.
interface Props { class?: string; app?: string; menubar?: boolean }
const { class: cls = '', app = 'Slinky', menubar = false } = Astro.props;
---
<div class={`desktop ${cls}`} data-desktop>
  {menubar && <div class="menubar" aria-hidden="true">
    <span class="mb-item mb-apple">&#xF8FF;</span>
    <span class="mb-item mb-app">{app}</span>
    <span class="mb-item">File</span><span class="mb-item">Edit</span><span class="mb-item">View</span>
    <span class="mb-item mb-more">Window</span><span class="mb-item mb-more">Help</span>
    <span class="mb-right">
      <span class="mb-item mb-icon" title="Slinky">
        <svg viewBox="0 0 18 18" width="18" height="18" aria-hidden="true"><defs><mask id="mb-slinky-hole" maskUnits="userSpaceOnUse" x="0" y="0" width="18" height="18"><rect width="18" height="18" fill="#fff"/><circle cx="9" cy="8" r="1.15"/><rect x="8.5" y="8.8" width="1" height="2.4"/></mask></defs><g mask="url(#mb-slinky-hole)" stroke="currentColor" stroke-width="3" stroke-linecap="round"><path d="M9.891 2.662 8.109 15.338M3.957 5.06l10.086 7.88M3.066 11.397l11.868-4.794"/></g></svg>
      </span>
      <span class="mb-item mb-icon mb-more">
        <svg viewBox="0 0 26 13" width="23" height="11.5"><rect x="0.6" y="0.6" width="21.8" height="11.8" rx="3.4" fill="none" stroke="currentColor" stroke-opacity="0.45" stroke-width="1.2"/><rect x="2.4" y="2.4" width="15.4" height="8.2" rx="1.8" fill="currentColor"/><path d="M23.8 4.4v4.2a2.2 2.2 0 0 0 0-4.2Z" fill="currentColor" fill-opacity="0.5"/></svg>
      </span>
      <span class="mb-item mb-icon">
        <svg viewBox="0 0 20 14" width="16" height="12"><path fill="currentColor" d="M10 2.4c2.7 0 5.2 1 7 2.8l1.3-1.3A11.7 11.7 0 0 0 10 .5 11.7 11.7 0 0 0 1.7 3.9L3 5.2a9.9 9.9 0 0 1 7-2.8Zm0 3.8c1.7 0 3.2.6 4.3 1.7l1.3-1.3A7.9 7.9 0 0 0 10 4.3c-2.2 0-4.1.9-5.6 2.3l1.3 1.3A6.1 6.1 0 0 1 10 6.2Zm0 3.7c.7 0 1.4.3 1.9.8L10 12.6l-1.9-1.9c.5-.5 1.2-.8 1.9-.8Z"/></svg>
      </span>
      <span class="mb-item mb-icon">
        <svg viewBox="0 0 16 16" width="13.5" height="13.5"><circle cx="6.6" cy="6.6" r="5" fill="none" stroke="currentColor" stroke-width="1.7"/><path d="m10.4 10.4 4.1 4.1" stroke="currentColor" stroke-width="1.9" stroke-linecap="round"/></svg>
      </span>
      <span class="mb-item mb-icon">
        <svg viewBox="0 0 18 16" width="15" height="13.5"><rect x="0.9" y="1.4" width="16.2" height="5.6" rx="2.8" fill="none" stroke="currentColor" stroke-width="1.5"/><circle cx="13.7" cy="4.2" r="1.7" fill="currentColor"/><rect x="0.9" y="9" width="16.2" height="5.6" rx="2.8" fill="none" stroke="currentColor" stroke-width="1.5"/><circle cx="4.3" cy="11.8" r="1.7" fill="currentColor"/></svg>
      </span>
      <span class="mb-item mb-clock" data-clock>Fri Oct 17&nbsp;&nbsp;9:41 AM</span>
    </span>
  </div>}
  <div class="desktop__stage"><slot /></div>
</div>
