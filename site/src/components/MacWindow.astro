---
// Slinky's main window, rebuilt in HTML: glass window, glass sidebar, the lock switch.
import Icon from './Icon.astro';
import Monogram from './Monogram.astro';
interface Props { title: string; subtitle?: string; selected?: string; class?: string; sidebar?: boolean; id?: string }
const { title, subtitle, selected = 'all', class: cls = '', sidebar = true, id } = Astro.props;
const rows = [
  { id: 'all', icon: 'grid', label: 'All Items', count: 6 },
  { id: 'keys', icon: 'key', label: 'Keys & Tokens', count: 3 },
  { id: 'recovery', icon: 'life', label: 'Recovery', count: 3 },
];
const projects = [
  { name: 'Slinky', count: '12' },
  { name: 'harbor-app', warn: '2 missing' },
  { name: 'Portfolio', count: '5' },
];
---
<div class={`mac ${sidebar ? '' : 'mac--small'} ${cls}`} data-glass="window" id={id} role="img" aria-label={`A recreation of Slinky's ${title} window`}>
  {sidebar && (
    <aside class="mac__sidebar" data-glass="panel">
      <div class="mac__lights"><i></i><i></i><i></i></div>
      <div class="mac__search"><Icon name="search" /> Search</div>
      {rows.map((r) => (
        <div class={`mac__row ${selected === r.id ? 'is-on' : ''}`}><Icon name={r.icon} />{r.label}<span class="count">{r.count}</span></div>
      ))}
      <div class="mac__row"><Icon name="attention" class="warn-icon" />Needs Attention<span class="count">2</span></div>
      <div class="mac__heading">Projects</div>
      {projects.map((p) => (
        <div class={`mac__row ${selected === p.name ? 'is-on' : ''}`}><Monogram text={p.name} size={18} />{p.name}{p.warn ? <span class="warn">{p.warn}</span> : <span class="count">{p.count}</span>}</div>
      ))}
      <div class="mac__foot"><Icon name="plusc" /> New Project</div>
    </aside>
  )}
  <div class="mac__main">
    <header class="mac__toolbar">
      {!sidebar && <div class="mac__lights" style="padding:0 6px 0 2px"><i></i><i></i><i></i></div>}
      {sidebar && (
        // Tahoe draws toolbar buttons as glass circles. The glyph is SF Symbols' sidebar.left: an outline
        // window, a divider a third of the way in, and three short lines in the left pane.
        <span class="sb" data-glass="capsule"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.55" stroke-linecap="round" aria-hidden="true"><rect x="2.8" y="4.6" width="18.4" height="14.8" rx="3.4"/><path d="M9.3 4.8v14.4M5.3 8.4h1.6M5.3 10.9h1.6M5.3 13.4h1.6"/></svg></span>
      )}
      <div class="mac__title"><b>{title}</b>{subtitle && <span>{subtitle}</span>}</div>
      <button class="lock-switch" data-glass="capsule" data-lock-switch aria-label="Lock Slinky (demo)" type="button">
        <i class="knob"></i>
        <span class="is-on"><Icon name="lockopen" /></span>
        <span><Icon name="lock" /></span>
      </button>
    </header>
    <div class="mac__detail"><slot /></div>
  </div>
  <slot name="over" />
</div>

<style>
  .mac :global(.warn-icon) { color: var(--orange) !important; }
</style>
