---
// A feature row as an editorial list: a headline, then the features split by hairlines, beside a desktop.
// The desktop's content goes in the default slot.
import Desktop from './Desktop.astro';
import Icon from './SiteIcon.astro';
interface Feature { icon: string; title: string; text: string }
interface Props { eyebrow: string; title: string; features: Feature[]; flip?: boolean }
const { eyebrow, title, features, flip = false } = Astro.props;
---
<div class:list={['g-row', 'e-row', 'reveal', { 'is-flip': flip }]}>
  <div class="g-copy">
    <p class="eyebrow">{eyebrow}</p>
    <h2 class="g-title" set:html={title} />
    <ul class="e-list">
      {features.map((f) => (
        <li><Icon name={f.icon} class="feature-icon" /><div><h3>{f.title}</h3><p>{f.text}</p></div></li>
      ))}
    </ul>
  </div>
  <Desktop class="g-desk"><slot /></Desktop>
</div>
