/// A service people keep keys and codes for. Used only to pick an icon: never sent anywhere.
public struct Service: Hashable, Sendable, Identifiable {
    public let id: String
    public let name: String
    /// Websites that belong to it, so a saved link can tell which service it is.
    public let domains: [String]
    /// Its Mac apps, so the real app icon shows when one is installed.
    public let bundleIDs: [String]
    /// Other words for it ("gh", "claude", "apple account").
    public let aliases: [String]
    /// Brand color as 0xRRGGBB, from Simple Icons.
    public let color: UInt32?
    /// A bundled logo exists, named `logo-<id>` in the app's asset catalog.
    public let hasLogo: Bool

    public var logoName: String? { hasLogo ? "logo-\(id)" : nil }

    /// Whether the brand color is light enough that the logo should be dark on it.
    public var prefersDarkGlyph: Bool {
        guard let color else { return false }
        let r = Double((color >> 16) & 0xFF) / 255, g = Double((color >> 8) & 0xFF) / 255, b = Double(color & 0xFF) / 255
        return 0.2126 * r + 0.7152 * g + 0.0722 * b > 0.62
    }
}

